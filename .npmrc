# pnpm configuration
# https://pnpm.io/npmrc

# Enable strict peer dependency resolution
strict-peer-dependencies=true

# Auto-install peer dependencies
auto-install-peers=true

# Save exact versions to lockfile
save-exact=true

# Use node-linker=hoisted for better compatibility
node-linker=hoisted

# Shamefully hoist for compatibility with tools that don't support pnpm's layout
shamefully-hoist=true

# Store dir for global packages
store-dir=~/.pnpm-store

# Network
registry=https://registry.npmjs.org/

# Prevent accidental publishes
publishConfig:
  access: restricted