    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "openapi-typescript-codegen": "^2.0.0"
  }
}