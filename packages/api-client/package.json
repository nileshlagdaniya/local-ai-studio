{
  "name": "@local-ai-studio/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated API client and types for Local AI Studio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "openapi-typescript-codegen --input ../../apps/api/openapi.json --output ./src --client axios",
