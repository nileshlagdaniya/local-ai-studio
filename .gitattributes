# =============================================================================
# Local AI Studio - Git Attributes
# =============================================================================
# Ensures consistent line endings and proper file handling across platforms
# =============================================================================

# -----------------------------------------------------------------------------
# Line Endings
# -----------------------------------------------------------------------------
# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.md text
*.txt text
*.json text
*.yaml text
*.yml text
*.toml text
*.ini text
*.cfg text
*.conf text
*.js text
*.jsx text
*.ts text
*.tsx text
*.py text
*.css text
*.scss text
*.html text
*.htm text
*.xml text
*.svg text
*.csv text
*.sql text
*.sh text
*.ps1 text
*.bat text
*.cmd text
*.dockerfile text
*.gitignore text
*.gitattributes text
*.editorconfig text
*.npmrc text
*.env* text
Dockerfile* text
Makefile* text
*.lock text

# -----------------------------------------------------------------------------
# Binary Files (do not normalize line endings)
# -----------------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.mov binary
*.avi binary
*.mkv binary
*.mp3 binary
*.wav binary
*.flac binary
*.ogg binary
*.m4a binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pkl binary
*.pickle binary
*.onnx binary
*.pt binary
*.pth binary
*.bin binary
*.gguf binary
*.safetensors binary

# -----------------------------------------------------------------------------
# Lock Files (always LF)
# -----------------------------------------------------------------------------
pnpm-lock.yaml text eol=lf
uv.lock text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf
requirements.txt text eol=lf
Pipfile.lock text eol=lf

# -----------------------------------------------------------------------------
# Diff Patterns
# -----------------------------------------------------------------------------
*.py diff=python
*.js diff=javascript
*.jsx diff=javascript
*.ts diff=typescript
*.tsx diff=typescript
*.json diff=json
*.md diff=markdown
*.css diff=css
*.html diff=html
*.yaml diff=yaml
*.yml diff=yaml
*.toml diff=toml
*.sql diff=sql
*.sh diff=bash
*.ps1 diff=powershell

# -----------------------------------------------------------------------------
# Merge Patterns
# -----------------------------------------------------------------------------
*.json merge=union
*.lock merge=union
*.md merge=union

# -----------------------------------------------------------------------------
# Export Ignore (files not included in git archive)
# -----------------------------------------------------------------------------
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
*.log export-ignore
node_modules/ export-ignore
.venv/ export-ignore
venv/ export-ignore
.env export-ignore
.env.local export-ignore
.env.production export-ignore
.next/ export-ignore
dist/ export-ignore
build/ export-ignore
.turbo/ export-ignore
.vercel/ export-ignore
coverage/ export-ignore
.pytest_cache/ export-ignore
.mypy_cache/ export-ignore
.ruff_cache/ export-ignore
storage/ export-ignore
data/*.db export-ignore
logs/ export-ignore
*.tmp export-ignore
*.bak export-ignore